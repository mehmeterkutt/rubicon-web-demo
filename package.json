{
  "name": "rubicon-web-demo",
  "private": true,
  "description": "Browser host app and fake backend for trying the Rubicon web analytics SDK by hand and with Playwright.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "check": "scripts/check.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "python3 fake-server/server.py",
    "test:server": "python3 -m unittest discover -s fake-server",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "rubicon-analytics": "link:../../rubicon-web-sdk/packages/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
